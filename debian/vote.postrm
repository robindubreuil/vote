#!/bin/bash
set -e

case "$1" in
    purge)
        # Remove data directory on purge
        # Uncomment to also remove persistent stats
        # rm -rf /var/lib/vote

        # Remove user and group
        if getent passwd vote > /dev/null 2>&1; then
            deluser --system vote || true
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# D19: daemon-reload / unit cleanup is owned by debhelper
# (dh_installsystemd snippets at #DEBHELPER#). Manual daemon-reload was
# redundant parallel-management.
#DEBHELPER#

exit 0
