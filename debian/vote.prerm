#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# D19: the systemd stop-before-remove sequence is owned by debhelper
# (dh_installsystemd snippets at #DEBHELPER#). Manual `systemctl stop`
# was redundant parallel-management.
#DEBHELPER#

exit 0
