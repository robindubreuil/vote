#!/usr/bin/make -f

# Work around Go's GOPATH behavior in package builds
export GOCACHE=$(CURDIR)/.gocache
export GOMODCACHE=$(CURDIR)/.gomodcache
export CGO_ENABLED=0

# D23: reproducible build. SOURCE_DATE_EPOCH is exported by
# dpkg-buildpackage (see Debian Policy / Reproducible Builds); if the
# caller didn't set it, derive it from the committer timestamp of HEAD
# so the same source commit always bakes the same BUILD_TIME into the
# binary. Falling back to `date` would make two builds of the same
# .deb produce different binaries and break bit-for-bit reproducibility.
BUILD_TIME := $(shell (v=$$SOURCE_DATE_EPOCH; if [ -z "$$v" ]; then v=$$(git show -s --format=%ct HEAD 2>/dev/null); fi; [ -n "$$v" ] && TZ=UTC date -d "@$$v" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null) || date -u +"%Y-%m-%dT%H:%M:%SZ")
export SOURCE_DATE_EPOCH ?= $(shell git show -s --format=%ct HEAD 2>/dev/null)

# Version metadata for both the frontend footer (gen-version.js, read
# via VOTE_* env) and the backend ldflags below. `?=` lets CI inject
# host-derived values (release.yml's build-deb job runs git on the
# runner, where it works, and passes them in as env). The `$(shell git
# …)` fallback covers a local `dpkg-buildpackage`; in the CI deb
# container git runs as root against a runner-owned .git and trips
# safe.directory — Dockerfile.deb allows it system-wide as a backstop,
# and the injected env is the authoritative source there.
VOTE_VERSION ?= $(shell head -1 debian/changelog | sed -n 's/.*(\([^)]*\)).*/\1/p')
VOTE_GIT_COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
VOTE_GIT_FULL_COMMIT ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
VOTE_BUILD_DATE ?= $(BUILD_TIME)
export VOTE_VERSION VOTE_GIT_COMMIT VOTE_GIT_FULL_COMMIT VOTE_BUILD_DATE

%:
	dh $@

# Skip tests during package build (run separately)
override_dh_auto_test:
	@echo "Tests skipped during package build"

# Skip dwz for Go binaries
override_dh_dwz:
	@echo "Skipping dh_dwz for Go binary"

# D19: the .default file ships dev-only CORS origins and a documented
# /etc/default/vote template; auto-starting on first install would
# expose that to the network before the operator has reviewed it.
# --no-start keeps enable + stop semantics (so upgrades and `systemctl
# start vote` work as expected) but skips the postinst start.
override_dh_installsystemd:
	dh_installsystemd --no-start

# Skip auto configure (we don't use autotools)
override_dh_auto_configure:
	@echo "Configure not needed for Go"

# Build the Go binary and Frontends
override_dh_auto_build:
	# Build Backend
	cd backend && go build -buildvcs=false \
		-ldflags="-X main.version=$(VOTE_VERSION) -X main.buildTime=$(VOTE_BUILD_DATE) -X main.gitCommit=$(VOTE_GIT_COMMIT) -s -w" \
		-o ../vote-server ./cmd/server

	# Build Frontend (single build for both formateur & stagiaire)
	cd frontend && npm ci --ignore-scripts && npm run build

# Install files manually
override_dh_auto_install:
	# Install binary
	install -D -m 0755 vote-server debian/vote/usr/bin/vote-server

	# systemd unit is auto-installed by dh_installsystemd from
	# debian/vote.service — no manual install needed.

	# Install Default Config
	install -D -m 0644 debian/vote.default debian/vote/etc/default/vote

	# Install Frontend Assets (single build output with both apps)
	install -d -m 0755 debian/vote/usr/share/vote/www
	cp -a frontend/dist/. debian/vote/usr/share/vote/www/

	# Install sample Caddyfile
	install -D -m 0644 debian/Caddyfile.example debian/vote/usr/share/doc/vote/examples/Caddyfile

	# Create state directory
	install -d -m 0700 debian/vote/var/lib/vote

override_dh_auto_clean:
	rm -f vote-server
	rm -rf debian/vote
	rm -rf frontend/dist frontend/node_modules
	rm -rf .gocache .gomodcache