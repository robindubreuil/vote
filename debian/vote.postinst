#!/bin/bash
set -e

case "$1" in
    configure)
        # Create vote user and group if they don't exist
        if ! getent passwd vote > /dev/null 2>&1; then
            adduser --system --group --home /var/lib/vote \
                --gecos "Vote Coloré server" --shell /usr/sbin/nologin \
                vote || true
        fi

        # Create and set permissions for the data directory
        install -d -o vote -g vote -m 0700 /var/lib/vote
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# D19: the systemd enable / daemon-reload / start sequence is fully
# owned by debhelper: dh_installsystemd (invoked via `dh $@` because we
# ship a .service) injects the matching snippets at the marker below.
# The previous manual `systemctl enable/daemon-reload` calls were
# redundant (idempotent, but parallel-management). Combined with
# `override_dh_installsystemd --no-start` in debian/rules, the service
# is enabled on install but NOT auto-started — the operator first
# reviews /etc/default/vote (default dev origins) and then `systemctl
# start vote`.
#DEBHELPER#

exit 0
